# Copy via pnpm setup:env; it generates a random key and refuses to overwrite .env.local.
ANVIL_RPC_URL=http://127.0.0.1:8545
DEMO_DB=.data/base-sepolia.sqlite
PUBLIC_ASSET_MODE=sepolia
DEMO_PROFILE=ten-usdc
PUBLIC_TRANSACTIONS_ENABLED=false
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# AI_MODE=gemini enables server-side Gemini API calls. Keep the key out of the browser.
AI_MODE=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# AI_MODE=local configuration (Ollama / local LLM server)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_NUM_CTX=
LOCAL_LLM_MAX_OUTPUT_TOKENS=
LOCAL_LLM_TIMEOUT_MS=
LOCAL_LLM_TEMPERATURE=
LOCAL_LLM_MAX_RETRIES=
# Server-only 32-byte random hex. Keep this together with the persistent DB backup.
CUSTODY_MASTER_KEY=

# Optional: import your own Base Sepolia test wallet. Leave blank to generate one locally.
DEMO_BANK_PRIVATE_KEY=

# Optional: import your own customer test wallet. Never use a mainnet wallet.
DEMO_CUSTOMER_PRIVATE_KEY=

# World ID (Orb) enrollment and policy approval (optional; requires Portal setup)
# See docs/world-setup.md. Never use NEXT_PUBLIC_ for the RP signing key.
# WORLD_FLOW=session reuses the enrolled World session for login and approval.
# Explicit local demo mode; omitted BANK_AUTH_MODE defaults to world.
BANK_AUTH_MODE=local-demo
BANK_AGENT_CREDENTIAL_FILE=.data/agent-credential
WORLD_MODE=disabled
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=production
WORLD_FLOW=session

# Official World ID for Agents sandbox (separate from IDKit above).
# Register an OIDC client using client_secret_basic. Keep both values server-side.
WORLD_AGENTS_CLIENT_ID=
WORLD_AGENTS_CLIENT_SECRET=
WORLD_AGENTS_REDIRECT_URI=https://agent-bank-demo.barabara0224.workers.dev/api/world-agents/callback
